extends application

append stylesheets
  link(href="api_mate.css", media="all", rel="stylesheet", type="text/css")
append javascripts
  script(type="text/javascript", src="api_mate.js")
  script(type="module").
    import { faker } from './vendor/faker-en.js'
    import { renderSVG } from './vendor/uqr.js'
    window.faker = faker
    window.renderQrCodeSVG = renderSVG

block footer_actions
  a#production-domains-toggle(href='#production-domains-modal', data-toggle='modal')
    i.glyphicon.glyphicon-lock
    | Production domains
    span(data-api-mate-production-domain='count')

append content

  #content.row.tab-content
    #menu.col-xs-7.col-sm-5
      include _menu

    #tab-all.col-xs-5.col-sm-7.tab-pane.active
      #api-mate-results

    //- #tab-config-xml.col-sm-8.tab-pane
    //-   include _tab_config_xml

    #post-response-modal.modal.fade
      .modal-dialog
        .modal-content
          .modal-header.alert
            button(type="button", class="close", data-dismiss="modal", aria-hidden="true")
              | &times;
            h4 Response
          .modal-body

    #production-domains-modal.modal.fade(tabindex='-1')
      .modal-dialog
        .modal-content
          .modal-header
            button.close(type='button', data-dismiss='modal', aria-hidden='true') &times;
            h4 Production domains
          .modal-body
            p.help-block
              | When the server matches one of these domains, the page header turns red.
              | The list is saved in this browser.
            .input-group.input-group-sm
              input#input-production-domain.form-control(type='text', placeholder='e.g. conf.example.com, node#.example.org, *customer*', data-api-mate-production-domain='input')
              span.input-group-btn
                button.btn.btn-danger(type='button', data-api-mate-production-domain='add')
                  | Add
            button.btn.btn-default.btn-sm(type='button', data-api-mate-production-domain='add-current')
              | Add current server
              code(data-api-mate-production-domain='current')
            ul#production-domains(data-api-mate-production-domain='list')
            p.empty(data-api-mate-production-domain='empty') No production domains configured.
          .modal-footer
            button.btn.btn-link.text-danger(type='button', data-api-mate-production-domain='clear')
              | Clear all
            button.btn.btn-default(type='button', data-dismiss='modal')
              | Close
